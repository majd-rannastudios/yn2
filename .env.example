# Port the server listens on (Railway injects this automatically)
PORT=3000

# PIN for the operator/admin console. CHANGE THIS before any real event.
ADMIN_PIN=1234

# Public URL guests reach the app on - the QR code encodes it, and it is the
# base of the redirect_uri sent to Yarnoo. e.g. https://event.yarnoo.com
# Leave blank locally and the server will use the request host.
PUBLIC_URL=

# Optional. If set, event state is persisted here and survives a restart/redeploy.
# Railway: add a Postgres service and this is injected for you.
DATABASE_URL=

# --- Sign in with Yarnoo ------------------------------------------------------
# Full contract for the Yarnoo side: docs/YARNOO-INTEGRATION.md

# off      - no Yarnoo sign-in; guests type their name (the default when nothing
#            below is configured)
# required - Yarnoo members only; the name form is closed (the default once
#            YARNOO_SIGNIN_URL and a key are set)
# optional - "Continue with Yarnoo", plus "Join as a guest" for walk-ins
YARNOO_AUTH=

# Yarnoo's page that signs the member in and redirects back with a token.
# The app appends ?redirect_uri=...&state=...&audience=...&event=...
YARNOO_SIGNIN_URL=

# How the token is verified - set ONE of these:
#   a secret shared with Yarnoo (HS256, at least 32 characters)...
YARNOO_JWT_SECRET=
#   ...or Yarnoo's public keys (RS256 / ES256 / EdDSA), e.g. https://yarnoo.com/.well-known/jwks.json
YARNOO_JWKS_URL=

# Must match the token's `iss` and `aud` claims.
YARNOO_JWT_ISSUER=https://yarnoo.com
YARNOO_JWT_AUDIENCE=spin-the-wheel

# Optional. When set, only tokens issued for this event (claim `event`, or a
# value in `events`) are accepted - i.e. only Yarnoo members registered for it.
YARNOO_EVENT_ID=

# Where the profile comes from: claims (in the token - the default), api, or postgres.
YARNOO_PROFILE_SOURCE=claims

# YARNOO_PROFILE_SOURCE=api - GET this URL ({id} = the member id), Bearer YARNOO_API_KEY.
YARNOO_PROFILE_URL=
YARNOO_API_KEY=

# YARNOO_PROFILE_SOURCE=postgres - a READ-ONLY role on Yarnoo's database, and a
# query taking the member id as $1. Column names: see docs/YARNOO-INTEGRATION.md.
YARNOO_DATABASE_URL=
YARNOO_PROFILE_SQL=
# verify (default - checks the certificate) | no-verify | disable
YARNOO_DATABASE_SSL=
# CA bundle (PEM) for a managed database with a private CA, e.g. RDS or Azure.
YARNOO_DATABASE_CA=

# Local testing only: a stand-in Yarnoo sign-in page at /auth/yarnoo/dev.
# Ignored when NODE_ENV=production; refuses to start next to any real Yarnoo setting above.
YARNOO_DEV_SIGNIN=
