{
  "name": "spin-the-wheel-colors",
  "version": "1.0.0",
  "private": true,
  "description": "Spin The Wheel: Colors - live networking activation for Yarnoo community events, with Sign in with Yarnoo. Built by Ranna Studios.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,yellow \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch src/server.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node src/server.js",
    "simulate": "node scripts/simulate.js",
    "e2e": "node scripts/e2e.js",
    "e2e:yarnoo": "node scripts/e2e-yarnoo.js",
    "load": "node scripts/load.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "dotenv": "^18.0.5",
    "express": "^4.19.2",
    "jose": "^6.2.12",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
